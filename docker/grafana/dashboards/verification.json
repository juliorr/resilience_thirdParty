{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "Verification Service",
  "uid": "verification",
  "tags": ["verification"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Third-party calls/s by source & outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (source, outcome) (rate(thirdparty_calls_total[1m]))",
          "legendFormat": "{{source}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "503 (unavailable) rate by source",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (source) (rate(thirdparty_calls_total{outcome=\"unavailable\"}[1m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Avg third-party latency by source (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (source) (rate(thirdparty_call_duration_seconds_sum[1m])) / sum by (source) (rate(thirdparty_call_duration_seconds_count[1m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Fallback rate (FREE -> PREMIUM)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(verification_fallback_total[1m])",
          "legendFormat": "fallback",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Verification result distribution",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (type) (verification_result_total)",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Verification logs (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "{app=\"verification\"} | json",
          "refId": "A"
        }
      ]
    }
  ]
}
