         "value": "ZZZZZ"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "const body = pm.response.json();",
         "pm.test('no match -> NO_RESULTS (or THIRD_PARTIES_DOWN)', () => {",
         "  pm.expect(body.result.status).to.be.oneOf(['NO_RESULTS', 'THIRD_PARTIES_DOWN']);",
         "});"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "Create -> retrieve -> duplicate (flow)",
   "description": "Chained scenario using one captured verificationId. Run the folder top-to-bottom (Collection Runner does this automatically).",
   "item": [
    {
     "name": "1. Create verification (verifier)",
     "request": {
      "method": "GET",
      "auth": {
       "type": "basic",
       "basic": [
        {
         "key": "username",
         "value": "{{verifierUser}}"
        },
        {
         "key": "password",
         "value": "{{verifierPass}}"
        }
       ]
      },
      "url": {
       "raw": "{{baseUrl}}/backend-service?verificationId={{flowId}}&query=CJQUNXGW",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "backend-service"
       ],
       "query": [
        {
         "key": "verificationId",
         "value": "{{flowId}}"
        },
        {
         "key": "query",
         "value": "CJQUNXGW"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('flowId', pm.variables.replaceIn('{{$guid}}'));"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "pm.test('verificationId echoes the generated id', () => {",
         "  pm.expect(pm.response.json().verificationId).to.eql(pm.collectionVariables.get('flowId'));",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "2. Retrieve by id (auditor)",
     "request": {
      "method": "GET",
      "auth": {
       "type": "basic",
       "basic": [
        {
         "key": "username",
         "value": "{{auditorUser}}"
        },
        {
         "key": "password",
         "value": "{{auditorPass}}"
        }
       ]
      },
      "url": {
       "raw": "{{baseUrl}}/verifications/{{flowId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "verifications",
        "{{flowId}}"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "const body = pm.response.json();",
         "pm.test('persisted record matches the created verification', () => {",
         "  pm.expect(body.verificationId).to.eql(pm.collectionVariables.get('flowId'));",
         "  pm.expect(body.queryText).to.eql('CJQUNXGW');",
         "  pm.expect(body).to.have.property('timestamp');",
         "  pm.expect(body.source).to.satisfy(s => s === 'FREE' || s === 'PREMIUM' || s === null || s === undefined);",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "3. Duplicate id is rejected (verifier)",
     "request": {
      "method": "GET",
      "auth": {
       "type": "basic",
       "basic": [
        {
         "key": "username",
         "value": "{{verifierUser}}"
        },
        {
         "key": "password",
         "value": "{{verifierPass}}"
        }
       ]
      },
      "url": {
       "raw": "{{baseUrl}}/backend-service?verificationId={{flowId}}&query=CJQUNXGW",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "backend-service"
       ],
       "query": [
        {
         "key": "verificationId",
         "value": "{{flowId}}"
        },
        {
         "key": "query",
         "value": "CJQUNXGW"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('reusing the verificationId returns 409 Conflict', () => pm.response.to.have.status(409));",
         "pm.test('problem body reports the conflict', () => {",
         "  const body = pm.response.json();",
         "  pm.expect(body.status).to.eql(409);",
         "  pm.expect(body.error).to.eql('Conflict');",
         "});"
        ]
       }
      }
     ]
    }
   ]
  },
