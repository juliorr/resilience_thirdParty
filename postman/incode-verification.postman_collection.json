{
 "info": {
  "name": "Incode Verification Service",
  "description": "Test cases for the verification service, built from the seed data in third-party-service/src/main/resources/data. Covers the FREE and PREMIUM third-party mocks, the orchestrating /backend-service, verification retrieval, the create->retrieve->duplicate flow, and auth/validation errors. Import the 'Incode Verification - Local' environment and start the stack with 'make up' before running.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://localhost:8080"
  },
  {
   "key": "thirdPartyUrl",
   "value": "http://localhost:8081"
  },
  {
   "key": "vid",
   "value": ""
  },
  {
   "key": "flowId",
   "value": ""
  },
  {
   "key": "loopMax",
   "value": "25"
  },
  {
   "key": "fbId",
   "value": ""
  },
  {
   "key": "cId",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "FREE third-party",
   "description": "Public mock. snake_case payload. Returns 503 ~40% of the time by design, so tests accept both 200 and 503.",
   "item": [
    {
     "name": "FREE - match by CIN (CJQUNXGW)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{thirdPartyUrl}}/free-third-party?query=CJQUNXGW",
       "host": [
        "{{thirdPartyUrl}}"
       ],
       "path": [
        "free-third-party"
       ],
       "query": [
        {
         "key": "query",
         "value": "CJQUNXGW"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200 or 503 (FREE fails ~40%)', () => pm.expect([200, 503]).to.include(pm.response.code));",
         "if (pm.response.code === 200) {",
         "  const body = pm.response.json();",
         "  pm.test('body is an array', () => pm.expect(body).to.be.an('array'));",
         "  pm.test('contains CJQUNXGW with snake_case fields', () => {",
         "    const hit = body.find(c => c.cin === 'CJQUNXGW');",
         "    pm.expect(hit, 'CJQUNXGW present').to.be.an('object');",
         "    pm.expect(hit).to.have.all.keys('cin', 'name', 'registration_date', 'address', 'is_active');",
         "  });",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "FREE - substring (FI7)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{thirdPartyUrl}}/free-third-party?query=FI7",
       "host": [
        "{{thirdPartyUrl}}"
       ],
       "path": [
        "free-third-party"
       ],
       "query": [
        {
         "key": "query",
         "value": "FI7"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200 or 503', () => pm.expect([200, 503]).to.include(pm.response.code));",
         "if (pm.response.code === 200) {",
         "  const body = pm.response.json();",
         "  pm.test('every CIN contains the substring FI7', () => body.forEach(c => pm.expect(c.cin).to.include('FI7')));",
         "  pm.test('FREE returns only FI75L0O9 (premium is the superset)', () => {",
         "    pm.expect(body.map(c => c.cin)).to.include('FI75L0O9');",
         "    pm.expect(body.map(c => c.cin)).to.not.include('FI7RM46P');",
         "  });",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "FREE - no match (ZZZZZ)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{thirdPartyUrl}}/free-third-party?query=ZZZZZ",
       "host": [
        "{{thirdPartyUrl}}"
       ],
       "path": [
        "free-third-party"
       ],
       "query": [
        {
         "key": "query",
         "value": "ZZZZZ"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200 or 503', () => pm.expect([200, 503]).to.include(pm.response.code));",
         "if (pm.response.code === 200) {",
         "  pm.test('empty array', () => pm.expect(pm.response.json()).to.be.an('array').that.is.empty);",
         "}"
        ]
       }
      }
     ]
    }
   ]
  },
