  {
   "name": "503 & fallback (deep)",
   "description": "Exercises the simulated 503 outages and the FREE->PREMIUM fallback explicitly. Block A is deterministic (no-results fallback, proves source=PREMIUM via retrieval). Blocks B and C use self-looping requests (pm.execution.setNextRequest) and ONLY work in the Collection Runner or Newman, not in a single Send. loopMax (collection variable, default 25) bounds the loops; with FREE at 40% the odds of not observing a 503 in 25 calls are ~3e-6.",
   "item": [
    {
     "name": "A1. Fallback (no-results) -> create (LDL93LOZ)",
     "request": {
      "method": "GET",
      "auth": {
       "type": "basic",
       "basic": [
        {
         "key": "username",
         "value": "{{verifierUser}}"
        },
        {
         "key": "password",
         "value": "{{verifierPass}}"
        }
       ]
      },
      "url": {
       "raw": "{{baseUrl}}/backend-service?verificationId={{fbId}}&query=LDL93LOZ",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "backend-service"
       ],
       "query": [
        {
         "key": "verificationId",
         "value": "{{fbId}}"
        },
        {
         "key": "query",
         "value": "LDL93LOZ"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('fbId', pm.variables.replaceIn('{{$guid}}'));"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "pm.test('echoes the generated verificationId', () => {",
         "  pm.expect(pm.response.json().verificationId).to.eql(pm.collectionVariables.get('fbId'));",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "A2. Fallback (no-results) -> source is PREMIUM",
     "request": {
      "method": "GET",
      "auth": {
       "type": "basic",
       "basic": [
        {
         "key": "username",
         "value": "{{auditorUser}}"
        },
        {
         "key": "password",
         "value": "{{auditorPass}}"
        }
       ]
      },
      "url": {
       "raw": "{{baseUrl}}/verifications/{{fbId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "verifications",
        "{{fbId}}"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "const body = pm.response.json();",
         "pm.test('LDL93LOZ exists only in PREMIUM, so a match proves the FREE->PREMIUM fallback', () => {",
         "  const result = body.result || {};",
         "  if (result.cin === 'LDL93LOZ') {",
         "    pm.expect(body.source, 'a LDL93LOZ match can only come from PREMIUM').to.eql('PREMIUM');",
         "  } else {",
         "    pm.expect(result.status, 'no match -> NO_RESULTS, or THIRD_PARTIES_DOWN if both providers were down').to.be.oneOf(['NO_RESULTS', 'THIRD_PARTIES_DOWN']);",
         "  }",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "B1. FREE 503 observed within N calls (CJQUNXGW)",
     "request": {
      "method": "GET",
      "auth": {
       "type": "noauth"
      },
      "url": {
       "raw": "{{thirdPartyUrl}}/free-third-party?query=CJQUNXGW",
       "host": [
        "{{thirdPartyUrl}}"
       ],
       "path": [
        "free-third-party"
       ],
       "query": [
        {
         "key": "query",
         "value": "CJQUNXGW"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "if (pm.collectionVariables.get('b_i') === undefined) {",
         "  pm.collectionVariables.set('b_i', 0);",
         "  pm.collectionVariables.set('b_seen', false);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const i = Number(pm.collectionVariables.get('b_i')) + 1;",
         "pm.collectionVariables.set('b_i', i);",
         "const max = Number(pm.collectionVariables.get('loopMax')) || 25;",
         "pm.test('status is 200 or 503 (FREE fails ~40%)', () => pm.expect([200, 503]).to.include(pm.response.code));",
         "if (pm.response.code === 503) {",
         "  pm.collectionVariables.set('b_seen', true);",
         "  const body = pm.response.json();",
         "  pm.test('503 body is a well-formed problem response', () => {",
         "    pm.expect(body.status).to.eql(503);",
         "    pm.expect(String(body.message || body.error || '')).to.match(/unavailable/i);",
         "  });",
         "}",
         "const seen = pm.collectionVariables.get('b_seen') === true;",
         "if (!seen && i < max) {",
         "  pm.execution.setNextRequest('B1. FREE 503 observed within N calls (CJQUNXGW)');",
         "} else {",
         "  pm.test(`a FREE 503 was observed within ${i} call(s)`, () => pm.expect(seen, 'no 503 seen; raise loopMax or check app.failure.free-probability').to.be.true);",
         "  pm.collectionVariables.unset('b_i');",
         "  pm.collectionVariables.unset('b_seen');",
         "}"
        ]
       }
      }
     ]
