  {
   "name": "Backend service (happy paths)",
   "description": "Orchestrating API: FREE first, fall back to PREMIUM, persist a record. Requires role VERIFIER or ADMIN. Always returns 200 (third-party 503s are absorbed by the orchestrator); the rare all-down case yields result.status THIRD_PARTIES_DOWN, which the assertions tolerate.",
   "auth": {
    "type": "basic",
    "basic": [
     {
      "key": "username",
      "value": "{{verifierUser}}"
     },
     {
      "key": "password",
      "value": "{{verifierPass}}"
     }
    ]
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.collectionVariables.set('vid', pm.variables.replaceIn('{{$guid}}'));"
      ]
     }
    }
   ],
   "item": [
    {
     "name": "Verify - active in FREE and PREMIUM (CJQUNXGW)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/backend-service?verificationId={{vid}}&query=CJQUNXGW",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "backend-service"
       ],
       "query": [
        {
         "key": "verificationId",
         "value": "{{vid}}"
        },
        {
         "key": "query",
         "value": "CJQUNXGW"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "const body = pm.response.json();",
         "pm.test('echoes verificationId and query', () => {",
         "  pm.expect(body.verificationId).to.eql(pm.collectionVariables.get('vid'));",
         "  pm.expect(body.query).to.eql('CJQUNXGW');",
         "});",
         "pm.test('result is a match for CJQUNXGW (or THIRD_PARTIES_DOWN if both down)', () => {",
         "  if (body.result && body.result.status) {",
         "    pm.expect(body.result.status).to.eql('THIRD_PARTIES_DOWN');",
         "  } else {",
         "    pm.expect(body.result.cin).to.eql('CJQUNXGW');",
         "    pm.expect(body.result.active).to.be.true;",
         "  }",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "Verify - FREE->PREMIUM fallback (LDL93LOZ)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/backend-service?verificationId={{vid}}&query=LDL93LOZ",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "backend-service"
       ],
       "query": [
        {
         "key": "verificationId",
         "value": "{{vid}}"
        },
        {
         "key": "query",
         "value": "LDL93LOZ"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "const body = pm.response.json();",
         "pm.test('LDL93LOZ exists only in PREMIUM: match comes from the fallback (unless down/PREMIUM 503)', () => {",
         "  if (body.result && body.result.status) {",
         "    pm.expect(body.result.status).to.be.oneOf(['NO_RESULTS', 'THIRD_PARTIES_DOWN']);",
         "  } else {",
         "    pm.expect(body.result.cin).to.eql('LDL93LOZ');",
         "  }",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "Verify - multiple active matches -> otherResults (Q)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/backend-service?verificationId={{vid}}&query=Q",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "backend-service"
       ],
       "query": [
        {
         "key": "verificationId",
         "value": "{{vid}}"
        },
        {
         "key": "query",
         "value": "Q"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "const body = pm.response.json();",
         "pm.test('first active match plus a non-empty otherResults array (unless both down)', () => {",
         "  if (body.result && body.result.status) {",
         "    pm.expect(body.result.status).to.eql('THIRD_PARTIES_DOWN');",
         "  } else {",
         "    pm.expect(body.result.active).to.be.true;",
         "    pm.expect(body.otherResults).to.be.an('array').that.is.not.empty;",
         "    pm.expect(body.otherResults.every(c => c.active)).to.be.true;",
         "  }",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "Verify - inactive only -> NO_RESULTS (0ANW1LCD)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/backend-service?verificationId={{vid}}&query=0ANW1LCD",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "backend-service"
       ],
       "query": [
        {
         "key": "verificationId",
         "value": "{{vid}}"
        },
        {
         "key": "query",
         "value": "0ANW1LCD"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('status is 200', () => pm.response.to.have.status(200));",
         "const body = pm.response.json();",
         "pm.test('inactive company -> NO_RESULTS (or THIRD_PARTIES_DOWN)', () => {",
         "  pm.expect(body.result.status).to.be.oneOf(['NO_RESULTS', 'THIRD_PARTIES_DOWN']);",
         "  pm.expect(body.otherResults).to.satisfy(o => o === undefined || o === null);",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "Verify - no match anywhere -> NO_RESULTS (ZZZZZ)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/backend-service?verificationId={{vid}}&query=ZZZZZ",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "backend-service"
       ],
       "query": [
        {
         "key": "verificationId",
         "value": "{{vid}}"
        },
